<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.image.Image?>
<FlowPane alignment="CENTER" hgap="20.0">
    <children>
        <Button contentDisplay="TOP" graphicTextGap="0.0" onAction="#save" text="Guardar">
            <graphic>
                <ImageView fitHeight="150.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../disk.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#delete" text="Borrar" />
        <Button mnemonicParsing="false" onAction="#goBack" text="Volver" />
    </children>
</FlowPane>